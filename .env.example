# ─────────────────────────────────────────────
# Epoxy - Hermes Agent Free-Tier Proxy
# ─────────────────────────────────────────────
#
# API keys are managed by editing this file
# through Pterodactyl's File Manager.
#
# After editing, restart the container or
# just send any request — keys reload
# automatically on change.
#
# Pool strategy env vars (optional per provider):
#   GROQ_POOL_STRATEGY=round_robin
#   OLLAMA_POOL_STRATEGY=round_robin
#   MISTRAL_POOL_STRATEGY=round_robin
#   CEREBRAS_POOL_STRATEGY=round_robin
#   DEEPSEEK_POOL_STRATEGY=round_robin
#   CLOUDFLARE_POOL_STRATEGY=round_robin
#   GOOGLE_POOL_STRATEGY=round_robin
# Values: fill_first, round_robin, least_used, random
# ─────────────────────────────────────────────

# Groq API keys — comma-separated for auto rotation
GROQ_API_KEYS=

# Ollama Cloud API keys — comma-separated
OLLAMA_API_KEYS=

# Mistral API keys — comma-separated (OpenAI-compatible)
MISTRAL_API_KEYS=

# Cerebras API keys — comma-separated (OpenAI-compatible)
CEREBRAS_API_KEYS=

# DeepSeek API keys — comma-separated (OpenAI-compatible)
DEEPSEEK_API_KEYS=

# Cloudflare Workers AI keys — comma-separated
# Each key format: account_id:api_token
CLOUDFLARE_API_KEYS=

# Google AI Studio API keys — comma-separated
# (translated to Gemini API format automatically)
GOOGLE_API_KEYS=
