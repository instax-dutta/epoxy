# ─────────────────────────────────────────────
# Epoxy - Hermes Agent Free-Tier Proxy
# ─────────────────────────────────────────────
# Copy this to .env and fill in your keys.
#
# Point Hermes Agent at this proxy:
#   custom_providers:
#     free-pool:
#       base_url: http://<your-server-ip>:8080
#
# Pool strategy env vars (optional):
#   GROQ_POOL_STRATEGY=round_robin
#   OLLAMA_POOL_STRATEGY=round_robin
# Values: fill_first, round_robin, least_used, random
# ─────────────────────────────────────────────

# Groq API keys (comma-separated for auto rotation)
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Ollama Cloud API keys (comma-separated for auto rotation)
OLLAMA_API_KEYS=your_ollama_key_here
